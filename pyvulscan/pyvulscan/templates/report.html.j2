<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PyVulScan report · {{ r.target }}</title>
<style>
  :root{
    --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --bg:#f6f8fb; --card:#ffffff;
    --critical:#b02a37; --high:#d9480f; --medium:#b7791f; --low:#2563eb; --info:#475569;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
       font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
  .wrap{max-width:980px;margin:0 auto;padding:36px 20px 72px}
  .top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;
       padding-bottom:22px;border-bottom:1px solid var(--line);flex-wrap:wrap}
  h1{margin:0 0 6px;font-size:26px;letter-spacing:-.02em}
  .sub{color:var(--muted);font-size:13px}
  .score{text-align:center;padding:14px 26px;border-radius:14px;background:var(--card);
         border:1px solid var(--line);min-width:150px}
  .score .num{font-size:34px;font-weight:700;line-height:1.1}
  .score .lbl{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .cards{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:26px 0 34px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}
  .card .n{font-size:22px;font-weight:700}
  .card .t{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  h2{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
     margin:0 0 14px}
  .finding{background:var(--card);border:1px solid var(--line);border-left-width:4px;
           border-radius:12px;padding:20px 22px;margin-bottom:14px}
  .finding.critical{border-left-color:var(--critical)}
  .finding.high{border-left-color:var(--high)}
  .finding.medium{border-left-color:var(--medium)}
  .finding.low{border-left-color:var(--low)}
  .finding.info{border-left-color:var(--info)}
  .head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
  .chip{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
        padding:3px 9px;border-radius:99px;color:#fff}
  .chip.critical{background:var(--critical)} .chip.high{background:var(--high)}
  .chip.medium{background:var(--medium)} .chip.low{background:var(--low)}
  .chip.info{background:var(--info)}
  .rid{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--muted);
       border:1px solid var(--line);border-radius:6px;padding:2px 7px}
  .title{font-weight:650;font-size:15.5px}
  .meta{font-size:12.5px;color:var(--muted);font-family:ui-monospace,Menlo,monospace}
  .block{margin-top:12px}
  .label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
  .evidence{background:#f1f5f9;border:1px solid var(--line);border-radius:8px;padding:11px 13px;
            font-family:ui-monospace,Menlo,monospace;font-size:12.5px;word-break:break-word}
  .fix{font-size:14px}
  .refs{margin-top:10px;font-size:12.5px}
  .refs a{color:#1d4ed8;text-decoration:none;margin-right:12px}
  footer{margin-top:36px;padding-top:18px;border-top:1px solid var(--line);
         font-size:12.5px;color:var(--muted)}
  @media (max-width:700px){.cards{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="wrap">

  <div class="top">
    <div>
      <h1>PyVulScan report</h1>
      <div class="sub">target {{ r.target }} · {{ r.started_at }} → {{ r.finished_at }}</div>
      <div class="sub">{{ r.ports|length }} port(s) probed · {{ r.fingerprints|length }} service(s) fingerprinted · {{ r.findings|length }} finding(s)</div>
    </div>
    <div class="score">
      <div class="num">{{ "%.1f"|format(r.score) }}<span style="font-size:15px;color:var(--muted)">/10</span></div>
      <div class="lbl">risk score · grade {{ r.grade }}</div>
    </div>
  </div>

  <div class="cards">
    {% for level in ['critical','high','medium','low','info'] %}
    <div class="card">
      <div class="n" style="color:var(--{{ level }})">{{ r.summary[level] }}</div>
      <div class="t">{{ level }}</div>
    </div>
    {% endfor %}
  </div>

  <h2>Findings</h2>
  {% for f in findings %}
  <div class="finding {{ f.severity }}">
    <div class="head">
      <span class="chip {{ f.severity }}">{{ f.severity }}</span>
      <span class="rid">{{ f.rule_id }}</span>
      <span class="title">{{ f.title }}</span>
    </div>
    <div class="meta">port {{ f.port or '-' }} · {{ f.service }}{% if f.product %} · {{ f.product }} {{ f.version }}{% endif %} · confidence {{ "%.0f"|format(f.confidence*100) }}% · CVSS-lite {{ "%.1f"|format(f.score) }}</div>
    <div class="block">
      <div class="label">Evidence</div>
      <div class="evidence">{{ f.evidence }}</div>
    </div>
    <div class="block">
      <div class="label">Remediation</div>
      <div class="fix">{{ f.remediation }}</div>
    </div>
    {% if f.references %}
    <div class="refs">
      {% for ref in f.references %}{% if ref.startswith('http') %}<a href="{{ ref }}" target="_blank" rel="noopener">{{ ref }}</a>{% else %}<span style="color:var(--muted);margin-right:12px">{{ ref }}</span>{% endif %}{% endfor %}
    </div>
    {% endif %}
  </div>
  {% else %}
  <div class="finding info"><div class="title">No findings. Only documented services are exposed.</div></div>
  {% endfor %}

  <footer>
    Generated by PyVulScan · detection and reporting only, no exploitation.
    Tested exclusively against a deliberately weak local target on loopback / RFC1918 addresses.
  </footer>
</div>
</body>
</html>
